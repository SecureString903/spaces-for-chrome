{
  "manifest_version": 3,
  "name": "Spaces — Workspaces for Chrome",
  "version": "0.4.1",
  "description": "Save your window's tabs into named Spaces and swap between them instantly. Work, personal, projects — one clean window per context.",
  "minimum_chrome_version": "116",
  "permissions": ["tabs", "storage", "sidePanel", "favicon", "bookmarks"],
  "background": {
    "service_worker": "background/index.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Open Spaces",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "next-space": {
      "suggested_key": { "default": "Ctrl+Shift+Period" },
      "description": "Switch to the next Space"
    },
    "prev-space": {
      "suggested_key": { "default": "Ctrl+Shift+Comma" },
      "description": "Switch to the previous Space"
    }
  }
}
